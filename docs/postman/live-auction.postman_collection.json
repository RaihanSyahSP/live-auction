{
  "info": {
    "name": "LELANG API",
    "description": "Collection untuk backend LELANG. Gunakan cookie jar Postman agar access_token dan refresh_token dari endpoint auth otomatis dikirim pada request berikutnya. Endpoint yang mengubah state membutuhkan header Origin yang sesuai dengan APP_ORIGIN.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "appOrigin",
      "value": "http://localhost:4173"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "bidderEmail",
      "value": "bidder@example.com"
    },
    {
      "key": "auctionId",
      "value": ""
    },
    {
      "key": "draftAuctionId",
      "value": ""
    },
    {
      "key": "bidId",
      "value": ""
    },
    {
      "key": "startingPrice",
      "value": "1000000"
    },
    {
      "key": "minIncrement",
      "value": "100000"
    },
    {
      "key": "bidAmount",
      "value": "1000000"
    }
  ],
  "item": [
    {
      "name": "Health dan Metrics",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/healthz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('health returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/metrics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('metrics returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('metrics contains bid counter', function () {",
                  "  pm.expect(pm.response.text()).to.include('auction_bids_total');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Bidder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{appOrigin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bidderEmail}}\",\n  \"password\": \"{{bidderPassword}}\",\n  \"display_name\": \"Postman Bidder\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register created or email already exists', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{appOrigin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin login succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Bidder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{appOrigin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bidderEmail}}\",\n  \"password\": \"{{bidderPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('bidder login succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('me returns current user', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{appOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refresh succeeds or reports race/expiry', function () {",
                  "  pm.expect([200, 401, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{appOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logout succeeds', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Public Auctions",
      "item": [
        {
          "name": "Current Auction",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auctions/current"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('current returns 200 or 204', function () {",
                  "  pm.expect([200, 204]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('auctionId', body.auction.id);",
                  "  pm.collectionVariables.set('bidAmount', String(body.auction.current_price));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Auction Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auctions/{{auctionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('detail returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Bid History",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auctions/{{auctionId}}/bids?limit=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('bid history returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Results",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/results?limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('results returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bid",
      "item": [
        {
          "name": "Place Bid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{appOrigin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{bidAmount}},\n  \"idempotency_key\": \"{{$guid}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auctions/{{auctionId}}/bids"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('bid created or replayed', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "if ([200, 201].includes(pm.response.code)) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('bidId', body.bid.id);",
                  "  pm.collectionVariables.set('bidAmount', String(body.auction.current_price + body.auction.min_increment));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List Auctions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/auctions?page=1&limit=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin list returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{appOrigin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Demo Auction\",\n  \"subtitle\": \"Created from Postman\",\n  \"description\": \"Auction created from the Postman collection.\",\n  \"condition\": \"Used\",\n  \"includes\": [\"Body\", \"Lens\"],\n  \"specs\": [\n    { \"label\": \"Sensor\", \"value\": \"24 MP\" }\n  ],\n  \"image_urls\": [],\n  \"starting_price\": {{startingPrice}},\n  \"min_increment\": {{minIncrement}},\n  \"duration_minutes\": 10\n}"
            },
            "url": "{{baseUrl}}/api/admin/auctions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('draft created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('draftAuctionId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Start Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{appOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/auctions/{{draftAuctionId}}/start"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('auction started', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('auctionId', body.id);",
                  "pm.collectionVariables.set('bidAmount', String(body.current_price));"
                ]
              }
            }
          ]
        },
        {
          "name": "End Auction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{appOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/auctions/{{auctionId}}/end"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('auction ended', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Draft",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Origin",
                "value": "{{appOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/auctions/{{draftAuctionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('draft deleted', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
